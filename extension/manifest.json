{
  "manifest_version": 3,
  "name": "Coder Browser Bridge",
  "version": "0.9.254",
  "description": "Local-only stealth-first browser bridge for Coder CLI",
  "key": "",
  "permissions": [
    "debugger",
    "tabs",
    "nativeMessaging",
    "cookies",
    "storage",
    "scripting",
    "activeTab",
    "webNavigation",
    "alarms",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "split",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Reconnect Coder Browser Bridge"
  },
  "minimum_chrome_version": "135"
}
