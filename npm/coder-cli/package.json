{
  "name": "@tjcoder/cli",
  "version": "0.9.273",
  "description": "Open-source terminal AI coding assistant. A keyboard-driven Go TUI with 7 specialized agents, 30+ tools, and a live reasoning pane. Works with local Ollama (private), Google Gemini, and the TJ Coder gateway.",
  "license": "MIT",
  "private": false,
  "bin": {
    "coder": "bin/coder.js"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node ./lib/fetch-binary.js",
    "preuninstall": "node ./lib/cleanup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32",
    "android"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tjcoder-labs/cli.git",
    "directory": "npm/coder-cli"
  },
  "bugs": {
    "url": "https://github.com/tjcoder-labs/cli/issues"
  },
  "homepage": "https://github.com/tjcoder-labs/cli#readme",
  "keywords": [
    "ai",
    "coding",
    "cli",
    "tui",
    "terminal",
    "ollama",
    "gemini",
    "agent",
    "assistant",
    "golang",
    "developer-tools",
    "code-generation",
    "llm",
    "open-source",
    "pair-programming",
    "terminal-ai"
  ]
}
