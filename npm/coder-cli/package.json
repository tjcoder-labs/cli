{
  "name": "@tjcoder/cli",
  "version": "0.9.226",
  "description": "Terminal-first AI coding assistant by TJ Coder / AI Labs. A keyboard-driven TUI with a live cognition pane, 7 specialized agents, and 31 tools, using the TJCoder ergo gateway by default, with local Ollama, Ollama Cloud and Gemini as options.",
  "license": "MIT",
  "private": false,
  "bin": {
    "coder": "bin/coder.js"
  },
  "files": [
    "bin/",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node ./lib/fetch-binary.js",
    "preuninstall": "node ./lib/cleanup.js"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32",
    "android"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tjcoder-labs/cli.git",
    "directory": "npm/coder-cli"
  },
  "bugs": {
    "url": "https://github.com/tjcoder-labs/cli/issues"
  },
  "homepage": "https://github.com/tjcoder-labs/cli#readme",
  "keywords": [
    "ai",
    "coding",
    "cli",
    "tui",
    "terminal",
    "ollama",
    "gemini",
    "agent",
    "assistant"
  ]
}
